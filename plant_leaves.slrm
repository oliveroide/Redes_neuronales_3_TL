#!/bin/bash
#SBATCH --account=curso04
#SBATCH --nodes=1
#SBATCH --job-name=plant_leaves
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=4:00:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=plant_leaves_%j.out
#SBATCH --error=plant_leaves_%j.err

module load conda
echo "Entrenando MobileNetV2 en plant_leaves"
source activate pinguinos

export TFDS_DATA_DIR=$HOME/tfds_data
export OUTPUT_DIR=${SLURM_SUBMIT_DIR:-$PWD}/resultados
export TF_CPP_MIN_LOG_LEVEL=2
mkdir -p "$OUTPUT_DIR"

nvidia-smi
python -u "${SLURM_SUBMIT_DIR:-$PWD}/plant_leaves.py"
